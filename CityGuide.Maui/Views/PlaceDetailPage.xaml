<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CityGuide.Maui.Views.PlaceDetailPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="*, Auto">

        <!-- ============ KAYDIRILABİLİR İÇERİK ============ -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- ============ HERO (üstte yüzen butonlarla) ============ -->
                <Grid HeightRequest="360">

                    <Image x:Name="HeroImage"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />

                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4D000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="0.3" />
                                <GradientStop Color="#00000000" Offset="0.7" />
                                <GradientStop Color="#99000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Üstte yüzen butonlar -->
                    <Grid ColumnDefinitions="Auto, *, Auto"
                          Padding="16,12"
                          VerticalOptions="Start">

                        <Border Grid.Column="0"
                                BackgroundColor="#33FFFFFF"
                                WidthRequest="40" HeightRequest="40"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">
                            <Label Text="&#xe5c4;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="22"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="#33FFFFFF"
                                WidthRequest="40" HeightRequest="40"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">
                            <Label Text="&#xe5d4;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="22"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                    </Grid>

                    <!-- Alt: rozet + başlık -->
                    <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,20" Spacing="6">
                        <Border BackgroundColor="#D4AF37"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,4"
                                HorizontalOptions="Start">
                            <Label x:Name="CategoryBadgeLabel"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   TextColor="#FFFFFF" />
                        </Border>
                        <Label x:Name="TitleLabel"
                               FontFamily="HankenBold"
                               FontSize="28"
                               TextColor="#FFFFFF" />
                    </VerticalStackLayout>

                </Grid>

                <!-- ============ GALERİ ŞERİDİ ============ -->
                <CollectionView x:Name="GalleryCollection"
                                HeightRequest="110"
                                Margin="20,16">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeThickness="1"
                                    Stroke="#C3C6D4"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="100"
                                    HeightRequest="100">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ============ AÇIKLAMA ============ -->
                <VerticalStackLayout Padding="20,8,20,0" Spacing="8">
                    <Label Text="Hakkında"
           FontFamily="HankenBold"
           FontSize="20"
           TextColor="#0D47A1" />
                    <Label x:Name="DescriptionLabel"
           FontFamily="HankenRegular"
           FontSize="15"
           TextColor="#434652"
           LineHeight="1.3" />
                </VerticalStackLayout>

                <!-- ============ QUICK INFO ============ -->
                <Grid Padding="20,16,20,0"
      ColumnDefinitions="*, *, *"
      ColumnSpacing="10">

                    <Border Grid.Column="0"
            BackgroundColor="#F3F4F5"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            Padding="12"
            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="&#xe8b5;"
                   FontFamily="MaterialSymbols"
                   FontSize="22"
                   TextColor="#0D47A1"
                   HorizontalOptions="Center" />
                            <Label Text="Süre"
                   FontFamily="Inter"
                   FontSize="11"
                   TextColor="#455A64"
                   HorizontalOptions="Center" />
                            <Label x:Name="DurationLabel"
                   FontFamily="HankenBold"
                   FontSize="13"
                   TextColor="#191C1D"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
            BackgroundColor="#F3F4F5"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            Padding="12"
            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="&#xe8a1;"
                   FontFamily="MaterialSymbols"
                   FontSize="22"
                   TextColor="#0D47A1"
                   HorizontalOptions="Center" />
                            <Label Text="Fiyat"
                   FontFamily="Inter"
                   FontSize="11"
                   TextColor="#455A64"
                   HorizontalOptions="Center" />
                            <Label x:Name="PriceQuickLabel"
                   FontFamily="HankenBold"
                   FontSize="13"
                   TextColor="#191C1D"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
            BackgroundColor="#F3F4F5"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            Padding="12"
            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="&#xe838;"
                   FontFamily="MaterialSymbols"
                   FontSize="22"
                   TextColor="#D4AF37"
                   HorizontalOptions="Center" />
                            <Label Text="Puan"
                   FontFamily="Inter"
                   FontSize="11"
                   TextColor="#455A64"
                   HorizontalOptions="Center" />
                            <Label x:Name="RatingQuickLabel"
                   FontFamily="HankenBold"
                   FontSize="13"
                   TextColor="#191C1D"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ============ KONUM ============ -->
                <VerticalStackLayout Padding="20,20,20,0" Spacing="12">

                    <Border BackgroundColor="#FFFFFF"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            Padding="16"
            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="12">

                            <Label Text="KONUM"
                   FontFamily="Inter"
                   FontSize="12"
                   TextColor="#455A64"
                   CharacterSpacing="1.5" />

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xe0c8;"
                       FontFamily="MaterialSymbols"
                       FontSize="18"
                       TextColor="#0D47A1" />
                                <Label x:Name="AddressLabel"
                       FontFamily="HankenRegular"
                       FontSize="14"
                       TextColor="#191C1D" />
                            </HorizontalStackLayout>

                            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="120">
                                <Image x:Name="MapImage" Aspect="AspectFill" />
                            </Border>

                            <Button Text="Haritada Aç"
                    Clicked="OnOpenMapsClicked"
                    BackgroundColor="#0D47A1"
                    TextColor="#FFFFFF"
                    FontFamily="HankenBold"
                    FontSize="14"
                    HeightRequest="46"
                    CornerRadius="10" />

                        </VerticalStackLayout>
                    </Border>

                    <!-- Save / Share -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button Grid.Column="0"
                Text="Kaydet"
                Clicked="OnSaveClicked"
                BackgroundColor="Transparent"
                TextColor="#0D47A1"
                BorderColor="#0D47A1"
                BorderWidth="1"
                FontFamily="HankenBold"
                FontSize="14"
                HeightRequest="46"
                CornerRadius="10" />
                        <Button Grid.Column="1"
                Text="Paylaş"
                Clicked="OnShareClicked"
                BackgroundColor="Transparent"
                TextColor="#0D47A1"
                BorderColor="#0D47A1"
                BorderWidth="1"
                FontFamily="HankenBold"
                FontSize="14"
                HeightRequest="46"
                CornerRadius="10" />
                    </Grid>

                </VerticalStackLayout>

                <!-- ============ İPUÇLARI (sabit, jenerik) ============ -->
                <VerticalStackLayout Padding="20,20,20,24" Spacing="12">

                    <Label Text="Ziyaret İpuçları"
           FontFamily="HankenBold"
           FontSize="20"
           TextColor="#0D47A1" />

                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="#FED65B"
                WidthRequest="28" HeightRequest="28"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">
                            <Label Text="&#xe5ca;"
                   FontFamily="MaterialSymbols"
                   FontSize="16"
                   TextColor="#745C00"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Uzun kuyrukları atlamak için biletleri önceden çevrimiçi alın."
               FontFamily="HankenRegular"
               FontSize="14"
               TextColor="#434652"
               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="#FED65B"
                WidthRequest="28" HeightRequest="28"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">
                            <Label Text="&#xe5ca;"
                   FontFamily="MaterialSymbols"
                   FontSize="16"
                   TextColor="#745C00"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="Ziyaret öncesi çalışma saatlerini kontrol etmeniz önerilir."
               FontFamily="HankenRegular"
               FontSize="14"
               TextColor="#434652"
               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="#FED65B"
                WidthRequest="28" HeightRequest="28"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">
                            <Label Text="&#xe5ca;"
                   FontFamily="MaterialSymbols"
                   FontSize="16"
                   TextColor="#745C00"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="En iyi fotoğraflar için sabah erken saatlerde ziyaret edin."
               FontFamily="HankenRegular"
               FontSize="14"
               TextColor="#434652"
               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>


            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ ALT SABİT REZERVASYON ÇUBUĞU ============ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, Auto"
              BackgroundColor="#FFFFFF"
              Padding="20,12"
              ColumnSpacing="16">

            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                <Label Text="Başlangıç fiyatı"
                       FontFamily="Inter"
                       FontSize="11"
                       TextColor="#455A64" />
                <Label x:Name="PriceInfoLabel"
                       FontFamily="HankenBold"
                       FontSize="20"
                       TextColor="#0D47A1" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Bilet Al"
                    Clicked="OnBookTicketsClicked"
                    BackgroundColor="#0D47A1"
                    TextColor="#FFFFFF"
                    FontFamily="HankenBold"
                    FontSize="14"
                    HeightRequest="48"
                    CornerRadius="10"
                    Padding="24,0"
                    VerticalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>
