<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CityGuide.Maui.Views.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ============ ÜST APP BAR ============ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              Padding="20,12"
              ColumnSpacing="12"
              BackgroundColor="#F8F9FA">

            <Border Grid.Column="0"
                    BackgroundColor="#0D47A1"
                    WidthRequest="36"
                    HeightRequest="36"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    VerticalOptions="Center">
                <Label Text="&#xea3b;"
                       FontFamily="MaterialSymbols"
                       FontSize="20"
                       TextColor="#FFFFFF"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1"
                   Text="İstanbul Şehir Rehberi"
                   FontFamily="HankenBold"
                   FontSize="20"
                   TextColor="#0D47A1"
                   VerticalOptions="Center" />

            <BoxView Grid.Column="2" Opacity="0" />

        </Grid>

        <!-- ============ KAYAN İÇERİK ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,20" Spacing="20">

                <!-- ============ PROFİL BAŞLIĞI ============ -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                    <Grid WidthRequest="96" HeightRequest="96">
                        <Border StrokeThickness="4"
                                Stroke="#FFFFFF"
                                StrokeShape="RoundRectangle 48"
                                WidthRequest="96"
                                HeightRequest="96">
                            <Image Source="profile.png" Aspect="AspectFill" />
                        </Border>

                        <Border BackgroundColor="#0D47A1"
                                StrokeThickness="2"
                                Stroke="#FFFFFF"
                                StrokeShape="RoundRectangle 14"
                                WidthRequest="28"
                                HeightRequest="28"
                                HorizontalOptions="End"
                                VerticalOptions="End">
                            <Label Text="&#xe3c9;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="14"
                                   TextColor="#FFFFFF"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Label x:Name="NameLabel"
                           FontFamily="HankenBold"
                           FontSize="22"
                           TextColor="#0D47A1"
                           HorizontalOptions="Center" />

                    <Label x:Name="EmailLabel"
                           FontFamily="HankenRegular"
                           FontSize="14"
                           TextColor="#455A64"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>

                <!-- ============ İSTATİSTİKLER ============ -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">

                    <Border Grid.Column="0"
        BackgroundColor="#FFFFFF"
        Stroke="#C3C6D4"
        StrokeThickness="1"
        Padding="16"
        StrokeShape="RoundRectangle 12">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="&#xe87d;"
               FontFamily="MaterialSymbols"
               FontSize="28"
               TextColor="#D4AF37"
               HorizontalOptions="Center" />

                            <Label x:Name="FavoriteCountLabel"
               FontFamily="HankenBold"
               FontSize="24"
               TextColor="#0D47A1"
               HorizontalOptions="Center" />

                            <Label Text="Favori Mekan"
               FontFamily="Inter"
               FontSize="11"
               TextColor="#455A64"
               HorizontalOptions="Center" />
                        </VerticalStackLayout>

                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#FFFFFF"
                            Stroke="#C3C6D4"
                            StrokeThickness="1"
                            Padding="16"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="&#xe55b;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="28"
                                   TextColor="#0D47A1"
                                   HorizontalOptions="Center" />
                            <Label x:Name="RouteCountLabel"
                                   FontFamily="HankenBold"
                                   FontSize="24"
                                   TextColor="#0D47A1"
                                   HorizontalOptions="Center" />
                            <Label Text="Toplam Rota"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   TextColor="#455A64"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- ============ MENÜ LİSTESİ ============ -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#C3C6D4"
                        StrokeThickness="1"
                        Padding="0"
                        StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="0">

                        <!-- Rezervasyonlarım -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#D9E2FF"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Label Text="&#xe138;"
                                       FontFamily="MaterialSymbols"
                                       FontSize="20"
                                       TextColor="#0D47A1"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Rezervasyonlarım"
                                   FontFamily="Inter"
                                   FontSize="15"
                                   TextColor="#191C1D"
                                   VerticalOptions="Center"
                                   Margin="12,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="&#xe5cc;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="20"
                                   TextColor="#737783"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EDEEEF" Margin="16,0" />

                        <!-- Kayıtlı Rehberler -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#FFE088"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Label Text="&#xe98b;"
                                       FontFamily="MaterialSymbols"
                                       FontSize="20"
                                       TextColor="#745C00"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Kayıtlı Rehberler"
                                   FontFamily="Inter"
                                   FontSize="15"
                                   TextColor="#191C1D"
                                   VerticalOptions="Center"
                                   Margin="12,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="&#xe5cc;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="20"
                                   TextColor="#737783"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EDEEEF" Margin="16,0" />

                        <!-- Ayarlar -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#EDEEEF"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Label Text="&#xe8b8;"
                                       FontFamily="MaterialSymbols"
                                       FontSize="20"
                                       TextColor="#455A64"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Ayarlar"
                                   FontFamily="Inter"
                                   FontSize="15"
                                   TextColor="#191C1D"
                                   VerticalOptions="Center"
                                   Margin="12,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="&#xe5cc;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="20"
                                   TextColor="#737783"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EDEEEF" Margin="16,0" />

                        <!-- Yardım & Destek -->
                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMenuItemTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0"
                                    BackgroundColor="#EDEEEF"
                                    WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20">
                                <Label Text="&#xe887;"
                                       FontFamily="MaterialSymbols"
                                       FontSize="20"
                                       TextColor="#455A64"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Yardım &amp; Destek"
                                   FontFamily="Inter"
                                   FontSize="15"
                                   TextColor="#191C1D"
                                   VerticalOptions="Center"
                                   Margin="12,0,0,0" />
                            <Label Grid.Column="2"
                                   Text="&#xe5cc;"
                                   FontFamily="MaterialSymbols"
                                   FontSize="20"
                                   TextColor="#737783"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ============ ÇIKIŞ YAP ============ -->
                <VerticalStackLayout Spacing="8" Margin="0,8,0,0">
                    <Button Text="Çıkış Yap"
                            Clicked="OnLogoutClicked"
                            BackgroundColor="Transparent"
                            TextColor="#BA1A1A"
                            BorderColor="#BA1A1A"
                            BorderWidth="2"
                            FontFamily="HankenBold"
                            FontSize="16"
                            HeightRequest="52"
                            CornerRadius="12" />
                    <Label Text="Sürüm 1.0.0 • İstanbul için üretildi"
                           FontFamily="Inter"
                           FontSize="11"
                           TextColor="#737783"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ ALT NAV BAR ============ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*, *, *, *"
              BackgroundColor="#FFFFFF"
              Padding="0,8"
              HeightRequest="64">

            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="&#xe88a;" FontFamily="MaterialSymbols" FontSize="24" TextColor="#737783" HorizontalOptions="Center" />
                <Label Text="Ana Sayfa" FontFamily="Inter" FontSize="11" TextColor="#737783" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDiscoverTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="&#xe87a;" FontFamily="MaterialSymbols" FontSize="24" TextColor="#737783" HorizontalOptions="Center" />
                <Label Text="Keşfet" FontFamily="Inter" FontSize="11" TextColor="#737783" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEventsTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="&#xe878;" FontFamily="MaterialSymbols" FontSize="24" TextColor="#737783" HorizontalOptions="Center" />
                <Label Text="Etkinlikler" FontFamily="Inter" FontSize="11" TextColor="#737783" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="&#xe7fd;" FontFamily="MaterialSymbols" FontSize="24" TextColor="#0D47A1" HorizontalOptions="Center" />
                <Label Text="Profil" FontFamily="Inter" FontSize="11" TextColor="#0D47A1" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
