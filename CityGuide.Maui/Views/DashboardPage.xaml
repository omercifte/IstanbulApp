                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="İstanbul"
                           FontFamily="Inter"
                           FontSize="12"
                           TextColor="#455A64"
                           HorizontalOptions="Center" />
                                    <Label x:Name="İstanbulTimeLabel"
                           Text="—"
                           FontFamily="HankenBold"
                           FontSize="22"
                           TextColor="#4A148C"
                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1"
                    BackgroundColor="#FFFFFF"
