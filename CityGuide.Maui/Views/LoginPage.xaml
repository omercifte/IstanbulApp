<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CityGuide.Maui.Views.LoginPage"
             Title="LoginPage"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="24"
                             VerticalOptions="Center">

           

            <!-- MARKA BAŞLIĞI -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                <!-- Logo kutusu: mavi kare içinde mimari ikonu -->
                <Border BackgroundColor="#0D47A1"
            WidthRequest="56"
            HeightRequest="56"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            HorizontalOptions="Center">
                    <Label Text="&#xea3b;"
               FontFamily="MaterialSymbols"
               FontSize="30"
               TextColor="#FFFFFF"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
                </Border>

                <!-- Başlık: headline-md 24 -->
                <Label Text="İstanbul Şehir Rehberi"
           FontFamily="HankenBold"
           FontSize="24"
           TextColor="#0D47A1"
           HorizontalOptions="Center"
           Margin="0,8,0,0" />

                <!-- Slogan: body-md 16 -->
                <Label Text="Özel rehberinize giriş yapın"
           FontFamily="HankenRegular"
           FontSize="16"
           TextColor="#455A64"
           HorizontalOptions="Center" />

            </VerticalStackLayout>


            <!-- FORM KARTI -->
            <Border BackgroundColor="#FFFFFF"
        Stroke="#C3C6D4"
        StrokeThickness="1"
        Padding="24"
        StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="16">

                    <!-- === E-POSTA ALANI === -->
                    <VerticalStackLayout Spacing="8">

                        <!-- Etiket: ikon + metin yan yana -->
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="&#xe0e6;"
                       FontFamily="MaterialSymbols"
                       FontSize="18"
                       TextColor="#455A64"
                       VerticalOptions="Center" />
                            <Label Text="E-posta Adresi"
                       FontFamily="Inter"
                       FontSize="14"
                       TextColor="#434652"
                       VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Giriş kutusu: sade -->
                        <Border Stroke="#C3C6D4"
                    StrokeThickness="1"
                    Padding="12,0"
                    StrokeShape="RoundRectangle 8">
                            <Entry x:Name="EmailEntry"
                       Placeholder="ornek@brera.it"
                       Keyboard="Email"
                       FontFamily="HankenRegular"
                       FontSize="16"
                       HeightRequest="48"
                       BackgroundColor="Transparent" />
                        </Border>

                    </VerticalStackLayout>

                    <!-- === ŞİFRE ALANI === -->
                    <VerticalStackLayout Spacing="8">

                        <!-- Etiket satırı: solda ikon+metin, sağda link -->
                        <Grid ColumnDefinitions="*, Auto">

                            <!-- Sol: kilit ikonu + "Şifre" -->
                            <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="&#xe897;"
                   FontFamily="MaterialSymbols"
                   FontSize="18"
                   TextColor="#455A64"
                   VerticalOptions="Center" />
                                <Label Text="Şifre"
                   FontFamily="Inter"
                   FontSize="14"
                   TextColor="#434652"
                   VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Sağ: şifremi unuttum linki -->
                            <Label Grid.Column="1"
               Text="Şifremi unuttum?"
               FontFamily="Inter"
               FontSize="12"
               TextColor="#0D47A1"
               VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                        </Grid>

                        <!-- Giriş kutusu: Entry + göz ikonu -->
                        <Border Stroke="#C3C6D4"
            StrokeThickness="1"
            Padding="12,0"
            StrokeShape="RoundRectangle 8">

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">

                                <!-- Şifre girişi -->
                                <Entry Grid.Column="0"
                   x:Name="PasswordEntry"
                   Placeholder="••••••••"
                   IsPassword="True"
                   FontFamily="HankenRegular"
                   FontSize="16"
                   HeightRequest="48"
                   BackgroundColor="Transparent" />

                                <!-- Göster/gizle ikonu -->
                                <Label Grid.Column="1"
                   x:Name="PasswordToggleIcon"
                   Text="&#xe8f4;"
                   FontFamily="MaterialSymbols"
                   FontSize="20"
                   TextColor="#455A64"
                   VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTogglePasswordVisibility" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                    <!-- === BENİ HATIRLA === -->
                    <HorizontalStackLayout Spacing="1">

                        <CheckBox x:Name="RememberCheckBox"
              Color="#0D47A1"
              VerticalOptions="Center" />

                        <Label Text="Beni hatırla"
           FontFamily="Inter"
           FontSize="14"
           TextColor="#455A64"
           VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <!-- === GİRİŞ YAP BUTONU === -->
                    <Button Text="Giriş Yap"
        x:Name="LoginButton"
        Clicked="OnLoginClicked"
        BackgroundColor="#0D47A1"
        TextColor="#FFFFFF"
        FontFamily="HankenBold"
        FontSize="16"
        HeightRequest="48"
        CornerRadius="8" />

                    <!-- === AYRAÇ === -->
                    <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="12">
                        <BoxView Grid.Column="0"
             HeightRequest="1"
             Color="#C3C6D4"
             VerticalOptions="Center" />
                        <Label Grid.Column="1"
           Text="VEYA ŞUNUNLA DEVAM ET"
           FontFamily="Inter"
           FontSize="12"
           TextColor="#737783"
           VerticalOptions="Center" />
                        <BoxView Grid.Column="2"
             HeightRequest="1"
             Color="#C3C6D4"
             VerticalOptions="Center" />
                    </Grid>

                    <!-- === SOSYAL BUTONLAR === -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">

                        <!-- Google -->
                        <Border Grid.Column="0"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="#FFFFFF">
                            <Label Text="Google"
               FontFamily="HankenRegular"
               FontSize="14"
               TextColor="#191C1D"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,12">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGoogleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                        <!-- Apple -->
                        <Border Grid.Column="1"
            Stroke="#C3C6D4"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="#FFFFFF">
                            <Label Text="Apple"
               FontFamily="HankenRegular"
               FontSize="14"
               TextColor="#191C1D"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="0,12">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAppleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>

                    </Grid>

                    <!-- === FOOTER: Erişim Talep Et === -->
                    <VerticalStackLayout Spacing="12" Margin="0,8,0,0">

                        <BoxView HeightRequest="1" Color="#C3C6D4" />

                        <Label HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               FontFamily="Inter"
                               FontSize="14"
                               TextColor="#455A64">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Hesabın yok mu? " />
                                    <Span Text="Bir Hesap Oluştur"
                                          TextColor="#0D47A1"
                                          FontFamily="HankenBold"
                                          TextDecorations="Underline">
                                        <Span.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRequestAccessTapped" />
                                        </Span.GestureRecognizers>
                                    </Span>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                    </VerticalStackLayout>


                </VerticalStackLayout>

            </Border>


            <!-- FOOTER -->
            <!-- ALT NOT -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label Text="&#xe9e9;"
                       FontFamily="MaterialSymbols"
                       FontSize="14"
                       TextColor="#737783"
                       VerticalOptions="Center" />
                <Label Text="Güvenli Veritabanı Erişimi"
                       FontFamily="Inter"
                       FontSize="12"
                       TextColor="#737783"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
